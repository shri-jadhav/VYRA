# VYRA Environment Configuration Example
# Copy this file to .env and adjust variables as necessary.
# DO NOT put raw AWS access keys or secrets in this file.

# Application Mode & Server
VYRA_ENV=development
VYRA_HOST=127.0.0.1
VYRA_PORT=8000
VYRA_DEBUG=true

# Database (Default: SQLite local database, git-ignored)
DATABASE_URL=sqlite:///./vyra.db

# AWS Assessment Configuration
# VYRA relies on standard local AWS credentials (e.g., ~/.aws/config)
# Mandatory default read-only profile:
AWS_PROFILE=vyra-readonly
AWS_DEFAULT_REGION=ap-south-1

# Expected AWS Account Identity Guard (Required for LIVE AWS assessment)
# Must match the AWS account returned by sts:GetCallerIdentity for profile 'vyra-readonly'.
# Leave empty for offline/demo mode, or specify the expected 12-digit account ID for live operations.
VYRA_EXPECTED_AWS_ACCOUNT_ID=


# Assessment Engine Limits & Safety Controls
# When set to true, explicitly triggered assessments can invoke read-only AWS APIs
ALLOW_LIVE_COLLECTION=true

# Enable dry-run only remediation workflows (strictly cannot mutate AWS resources)
REMEDIATION_DRY_RUN_ONLY=true

# Evidence and Report Artifact Directories
EVIDENCE_DIR=./data/evidence
REPORTS_DIR=./reports/exports
